# Server
PORT=3000
NODE_ENV=development

# Database (MariaDB)
DATABASE_URL="mysql://finance:your_db_password@localhost:3306/finance_planner"

# Gate screen password
APP_GATE_PASSWORD=change_me

# Sessions
GATE_SESSION_DAYS=30

# Comma-separated list of allowed browser origins (leave empty to allow all — dev only)
CORS_ORIGIN=
