# Server
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
TRUST_PROXY=false
PUBLIC_ORIGIN=

# Database (MariaDB)
DATABASE_URL="mysql://finance:your_db_password@localhost:3307/finance_planner"

# Login identity — read ONLY by modules/gate/credentials.ts, so swapping in a
# real auth store later means changing that one file.
APP_GATE_USERNAME=your_username
APP_GATE_PASSWORD=change_me

# Sessions
GATE_SESSION_DAYS=7
SESSION_IDLE_MINUTES=120

# Additional development origins; localhost is allowed by default. Production uses PUBLIC_ORIGIN.
CORS_ORIGIN=

# AI — which vendor modules/ai/ai.service.ts hands out. Only "claude" exists today.
AI_PROVIDER=claude
# Read ONLY by modules/ai/providers/claudeProvider.ts. Leave empty and the app
# still boots; the error appears when an AI call is actually made.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Where uploaded documents are stored, relative to backend/. Never committed (git-ignored).
DOCUMENT_STORAGE_DIR=storage/documents
